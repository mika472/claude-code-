{
  "mcpServers": {
    "gpt": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/mcp/gpt-bridge/server.mjs"
      ],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OPENAI_MODEL": "${OPENAI_MODEL:-gpt-5.1}",
        "OPENAI_IMAGE_MODEL": "${OPENAI_IMAGE_MODEL:-gpt-image-2}"
      },
      "timeout": 300000
    }
  }
}
